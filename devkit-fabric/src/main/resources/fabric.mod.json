{
  "schemaVersion": 1,
  "id": "devkit-api",
  "version": "${version}",
  "name": "DevKit API",
  "description": "Modular developer library for Fabric mods: registry, payload networking, data components, synchronized JSON configs, and datagen helpers.",
  "authors": ["jrxmod"],
  "contact": {
    "sources": "https://github.com/jrxmod/devkit-api",
    "issues": "https://github.com/jrxmod/devkit-api/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/devkit-api/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.jrxmod.devkit.fabric.DevkitMod"],
    "client": ["io.github.jrxmod.devkit.fabric.client.DevkitClient"],
    "fabric-datagen": ["io.github.jrxmod.devkit.datagen.DevkitDataGenerator"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "custom": {
    "devkit:api_version": 2,
    "modmenu:badges": ["library"]
  }
}
